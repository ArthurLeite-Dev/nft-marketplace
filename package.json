{
  "name": "marketplace-nft-junglegaming",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
    "lighthouse": "node scripts/lighthouse.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:realtime": "playwright test --project=desktop --project=mobile tests/e2e/realtime.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "msw": "2.15.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lighthouse": "^13.6.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
